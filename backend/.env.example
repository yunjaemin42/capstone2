# 서버 설정
PORT=3000

# 개발 모드: true면 S3/DynamoDB 대신 로컬 파일/메모리로 동작 (AWS 계정 없이 테스트 가능)
USE_LOCAL_MOCK=true

# ── 아래는 AWS 계정 준비되면 채우기 (USE_LOCAL_MOCK=false 로 바꾼 후 사용) ──
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

S3_BUCKET_NAME=recycling-inspection-images
DYNAMODB_TABLE_NAME=InspectionLog

# FCM (모바일 푸시 알림) - Firebase 콘솔에서 서버 키 발급 후 입력
FCM_SERVER_KEY=
